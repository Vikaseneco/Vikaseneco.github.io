---
import '../styles/fonts.css';
import '../styles/global.css';
import { url } from '../lib/url';

interface Props {
  title: string;
  description: string;
  home?: boolean;
  kind?: 'website' | 'article';
}

const { title, description, home = false, kind = 'website' } = Astro.props;
const fullTitle = home ? 'Vikas Yadav · SuperIntelligence Quality Assurance' : `${title} · Vikas Yadav`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;

const links = [
  { label: 'Home', href: url(''), kind: 'home' },
  { label: 'Blog', href: url('blog'), kind: 'section' },
  { label: 'Prompts', href: url('prompts'), kind: 'section' },
  { label: 'Skills', href: url('skills'), kind: 'section' },
  { label: 'Projects', href: url('projects'), kind: 'section' },
  { label: 'Desk', href: url('desk'), kind: 'section' },
] as const;

function current(href: string, kind: 'home' | 'section') {
  if (kind === 'home') return path === href;
  return path === href || path.startsWith(href);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f4efe4" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={kind} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="frame mast">
      <a class="brand" href={url('')}>
        <span class="brand-name">Vikas Yadav</span>
        <span class="role">SuperIntelligence Quality Assurance</span>
      </a>
      <nav class="nav" aria-label="Primary">
        {
          links.map((link) => (
            <a href={link.href} aria-current={current(link.href, link.kind) ? 'page' : undefined}>
              {link.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main id="content" class="frame">
      <slot />
    </main>
    <footer class="frame site-footer">
      <nav class="nav" aria-label="Footer">
        {
          links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))
        }
      </nav>
      <p>
        Vikas Yadav · SuperIntelligence Quality Assurance. Notes, prompts, and a practice desk. A model may draft. A person reviews.
      </p>
    </footer>
  </body>
</html>
