---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { projects } from '../../data/projects';
import { url } from '../../lib/url';
---

<Base
  title="Projects"
  description="Practices for AI in test automation: a plain-language case, a locator gate, one job first, and a pilot desk."
>
  <PageHead
    kicker="Projects"
    title="Practices, not packages."
    lede="These are ways of working that live on this site. Nothing here is a download, and nothing asks you to install an agent before you can try the idea."
  />
  {
    projects.map((project) => (
      <article class="project">
        <p class="project-kind">
          {project.year} · {project.kind}
        </p>
        <h2>{project.name}</h2>
        <p>{project.summary}</p>
        <p class="post-foot">
          <a href={url(project.href)}>{project.link}</a>
        </p>
      </article>
    ))
  }
</Base>
