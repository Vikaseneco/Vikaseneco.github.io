---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { formatDate, url } from '../../lib/url';

type NoteModule = {
  url: string;
  frontmatter: {
    title: string;
    description: string;
    date: string | Date;
    minutes: number;
  };
};

const notes = Object.values(import.meta.glob<NoteModule>('./*.md', { eager: true })).sort(
  (a, b) => +new Date(b.frontmatter.date) - +new Date(a.frontmatter.date),
);
---

<Base
  title="Blog"
  description="Plain-English lessons on AI in test automation: what an agent may change, how to write a case, how to repair a locator, and how to judge a pilot."
>
  <PageHead
    kicker="Blog"
    title="AI in test automation"
    lede="Lessons in plain English, read from public Chinese writing on agents that draft, run, and repair tests. The examples and the judgments are mine. A percentage from someone else’s shop is not a result."
  />
  <section class="learn-path" aria-labelledby="learn-heading">
    <h2 id="learn-heading">Read in this order</h2>
    <p>
      Start with the boundary, then the case, then the locator repair, then the pilot. Each note has a diagram and a short practice with the answer on the page.
    </p>
    <ol class="steps">
      <li>
        <a href={url('blog/what-ai-changes-in-automation')}>What AI changes in test automation</a>
      </li>
      <li>
        <a href={url('blog/write-the-case-then-run-it')}>Write the case, then let a runner try it</a>
      </li>
      <li>
        <a href={url('blog/repair-the-locator-not-the-rule')}>Repair the locator, not the rule</a>
      </li>
      <li>
        <a href={url('blog/start-with-one-job')}>Start with one job, then count</a>
      </li>
    </ol>
  </section>
  <ul class="note-list">
    {
      notes.map((note) => (
        <li>
          <a href={note.url}>
            <time datetime={new Date(note.frontmatter.date).toISOString().slice(0, 10)}>
              {formatDate(note.frontmatter.date)} · {note.frontmatter.minutes} min read
            </time>
            <strong>{note.frontmatter.title}</strong>
            <span>{note.frontmatter.description}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
