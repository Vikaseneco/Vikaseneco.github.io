---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { skills } from '../../data/skills';
import { url } from '../../lib/url';
---

<Base
  title="QA skills"
  description="Methods for AI in test automation, each opened with a real situation: a failed sign-in, a system prompt, a tool list, a long conversation, and a bot that must not say pass."
>
  <PageHead
    kicker="QA skills"
    title="Methods you can finish."
    lede="Each method starts from a situation a team actually hits: a red sign-in, a healer that edits the check, a system prompt that prefers success, a tool list with pay on it, or a conversation that is about to forget the rule. The map of the model and the harness is in the senior lesson."
  />

  <div class="layout">
    <nav class="side-nav" aria-label="Skills">
      {skills.map((skill) => <a href={`#${skill.id}`}>{skill.title}</a>)}
    </nav>
    <div>
      {
        skills.map((skill) => (
          <article class="skill" id={skill.id}>
            <h2>{skill.title}</h2>
            <p>{skill.summary}</p>
            <h3>A real situation</h3>
            <p class="scenario">{skill.scenario}</p>
            <details class="fold">
              <summary>Show the steps</summary>
              <h3>When</h3>
              <p>{skill.when}</p>
              <h3>Bring</h3>
              <ul>
                {skill.bring.map((item) => <li>{item}</li>)}
              </ul>
              <h3>Do</h3>
              <ol>
                {skill.steps.map((step) => <li>{step}</li>)}
              </ol>
              <h3>Leave with</h3>
              <ul>
                {skill.leave.map((item) => <li>{item}</li>)}
              </ul>
              <p class="caution">{skill.caution}</p>
            </details>
            <p class="post-foot">
              {skill.prompt && <a href={url(`prompts#${skill.prompt}`)}>Related prompt</a>}
              {skill.prompt && skill.desk && ' · '}
              {skill.desk && <a href={url('desk')}>Practice on the desk</a>}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</Base>
